# Exact Vercel production URL. Add comma-separated preview/custom domains if required.
ITCYBER_ALLOWED_ORIGINS=https://your-project.vercel.app

# These create the administrator safely before the public frontend connects.

# Railway persistent-volume paths.
ITCYBER_DATA_DIR=/data/dashboard_data
ITCYBER_OUTPUT_DIR=/data/output
ITCYBER_BROWSER_PROFILE_DIR=/data/browser_profile

# false uses Chromium in an Xvfb virtual display; true uses native headless mode.
ITCYBER_HEADLESS=false
